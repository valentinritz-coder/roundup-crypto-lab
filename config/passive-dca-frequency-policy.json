{
  "schema_version": "passive-dca-frequency-policy/v1",
  "policy_id": "passive-dca-frequency-policy-2026-07-29",
  "primary_control": "MonthlyDCA",
  "phase_treatment": "equal_weight_nuisance_replications",
  "ranking_rule": "frequency_aggregates_only_never_best_phase",
  "ranking_metric": "median_terminal_value_then_worst_window_then_phase_dispersion",
  "thresholds": {
    "minimum_exploratory_windows": 4,
    "minimum_confirmation_windows": 1,
    "robust_final_value_win_rate": "0.65",
    "promising_final_value_win_rate": "0.55",
    "rejected_final_value_win_rate_max": "0.35",
    "maximum_phase_dispersion_for_robust_result": "0.10"
  },
  "required_cost_components": [
    "explicit_fees_paid",
    "estimated_spread_cost",
    "total_execution_cost",
    "final_uninvested_cash",
    "order_count",
    "average_order_size"
  ],
  "required_analysis_components": [
    "gross_terminal_value",
    "net_terminal_value",
    "execution_cost_terminal_impact",
    "average_pending_cash_age_seconds",
    "maximum_pending_cash_age_seconds",
    "average_cash_balance",
    "average_capital_deployment_ratio",
    "contribution_neutralized_drawdown",
    "phase_dispersion"
  ],
  "notes": [
    "MonthlyDCA remains the primary benchmark for phase-aggregated frequency analysis.",
    "Phase-level rows are diagnostics and can never become the selected research result.",
    "Exploratory and confirmation phases must be classified separately.",
    "Overlapping and non-overlapping window sets must remain separate ranking groups.",
    "Overlapping windows and calendar phases within one market window are not independent observations.",
    "Gross terminal value is the matching frictionless result for the same frequency, phase and market window."
  ]
}
